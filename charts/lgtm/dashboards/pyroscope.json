    {
      "type": "gauge",
      "id": 7,
      "title": "Error Ratio",
      "description": "5xx as a fraction of requests.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 17,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.2,
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pyroscope_request_duration_seconds_count{job=\"pyroscope\",status_code=~\"5..\"}[$__rate_interval]))/clamp_min(sum(rate(pyroscope_request_duration_seconds_count{job=\"pyroscope\",route!~\"ready|metrics|opentelemetry.*\"}[$__rate_interval])),1)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
