          "expr": "sum(rate(pyroscope_request_duration_seconds_sum{job=\"pyroscope\",route=~\".*Push|ingest\"}[$__rate_interval])) / sum(rate(pyroscope_request_duration_seconds_count{job=\"pyroscope\",route=~\".*Push|ingest\"}[$__rate_interval]))",
          "legendFormat": "avg",
          "refId": "C",
          "editorMode": "code",
          "range": true,
