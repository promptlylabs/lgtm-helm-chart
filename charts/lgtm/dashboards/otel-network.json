          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (\"cloud.availability_zone\") (rate({__name__=\"k8s.node.network.io\", direction=\"receive\", \"cloud.availability_zone\"=~\"$zone\"}[$__rate_interval]))",
          "legendFormat": "zone-{{cloud.availability_zone}}",
          "refId": "A"
