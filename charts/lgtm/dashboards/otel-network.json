      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum({__name__=\"system.network.connections\", state=\"ESTABLISHED\"}) or vector(0)",
          "legendFormat": "established",
          "refId": "A"
        }
      ]
