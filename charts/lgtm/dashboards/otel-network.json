          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count by (\"cloud.availability_zone\") (group by (\"cloud.availability_zone\", \"k8s.node.name\") ({__name__=\"k8s.node.network.io\", direction=\"receive\", \"cloud.availability_zone\"=~\"$zone\"}))",
          "legendFormat": "zone-{{cloud.availability_zone}}",
          "refId": "A"
