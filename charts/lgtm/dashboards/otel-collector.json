{
  "annotations": {
    "list": []
  },
  "description": "OpenTelemetry Collector push pipeline (node DaemonSet + cluster StatefulSet): receivers \u2192 processors \u2192 exporters \u2192 sending queue, scrape health and resources. Self-metrics via the collectors' scope=observability ServiceMonitor (ADR-0012).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "platform"
      ],
      "targetBlank": false,
      "title": "Platform dashboards",
      "type": "dashboards"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "\u2190 Platform Overview",
      "type": "link",
      "url": "/d/home"
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Fleet",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "id": 2,
      "title": "Collectors",
      "description": "Node (DaemonSet) and cluster (StatefulSet) collectors with version + uptime.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Uptime",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "Uptime",
              "job": "Collector",
              "pod": "Pod",
              "service.version": "Version"
            },
            "indexByName": {}
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job, pod, \"service.version\") (otelcol_process_uptime_seconds_total{job=~\"$collector\"})",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Accepted",
      "description": "Items accepted by receivers (all signals).",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=~\"$collector\"}[$__rate_interval]))+sum(rate(otelcol_receiver_accepted_log_records_total{job=~\"$collector\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Exported",
      "description": "Items exported to backends.",
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_exporter_sent_metric_points_total{job=~\"$collector\"}[$__rate_interval]))+sum(rate(otelcol_exporter_sent_log_records_total{job=~\"$collector\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "type": "gauge",
      "id": 5,
      "title": "Metrics Refused",
      "description": "Receiver refusal ratio (metrics).",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_receiver_refused_metric_points_total{job=~\"$collector\"}[$__rate_interval]))/clamp_min(sum(rate(otelcol_receiver_accepted_metric_points_total{job=~\"$collector\"}[$__rate_interval]))+sum(rate(otelcol_receiver_refused_metric_points_total{job=~\"$collector\"}[$__rate_interval])),1)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "type": "gauge",
      "id": 6,
      "title": "Logs Refused",
      "description": "Receiver refusal ratio (logs).",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 4,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=~\"$collector\"}[$__rate_interval]))/clamp_min(sum(rate(otelcol_receiver_accepted_log_records_total{job=~\"$collector\"}[$__rate_interval]))+sum(rate(otelcol_receiver_refused_log_records_total{job=~\"$collector\"}[$__rate_interval])),1)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "type": "gauge",
      "id": 7,
      "title": "Queue Usage",
      "description": "Sending-queue fill (size/capacity). Near 1 = export backing up.",
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 8,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "\u2014",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(otelcol_exporter_queue_size{job=~\"$collector\"})/clamp_min(max(otelcol_exporter_queue_capacity{job=~\"$collector\"}),1)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Receivers",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Accepted by Signal",
      "description": "Accepted telemetry by signal (spans populate with traces).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "metrics"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "logs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "spans"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total{job=~\"$collector\"}[$__rate_interval]))",
          "legendFormat": "metrics",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total{job=~\"$collector\"}[$__rate_interval]))",
          "legendFormat": "logs",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total{job=~\"$collector\"}[$__rate_interval]))",
          "legendFormat": "spans",
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Refused & Failed",
      "description": "Refused (memory_limiter backpressure) & failed intake \u2014 should be flat zero.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "gradientMode": "opacity",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "axisColorMode": "text",
            "axisBorderShow": false
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
