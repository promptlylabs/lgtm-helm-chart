          "legendFormat": "refused metrics",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total{job=~\"$collector\"}[$__rate_interval]))",
          "legendFormat": "refused logs",
          "refId": "B",
