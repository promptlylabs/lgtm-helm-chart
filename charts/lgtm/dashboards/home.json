            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (\"k8s.namespace.name\")({__name__=\"k8s.pod.cpu.usage\"}) / sum by (\"k8s.namespace.name\")({__name__=\"k8s.container.cpu_request\"})",
