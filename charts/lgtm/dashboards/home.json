    {
      "asDropdown": true,
      "keepTime": true,
      "tags": [
        "platform"
      ],
      "title": "Platform",
      "type": "dashboards"
    },
    {
      "asDropdown": true,
      "keepTime": true,
      "tags": [
        "data"
      ],
      "title": "Data",
      "type": "dashboards"
