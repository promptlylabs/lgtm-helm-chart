          "expr": "count by (\"k8s.namespace.name\")({__name__=\"k8s.statefulset.desired_pods\"})",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (\"k8s.namespace.name\")({__name__=\"k8s.daemonset.desired_scheduled_nodes\"})",
          "format": "table",
          "instant": true,
          "refId": "D"
