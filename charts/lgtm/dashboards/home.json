          "format": "table",
          "instant": true,
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (\"k8s.namespace.name\")({__name__=\"k8s.pod.cpu.usage\"})",
          "format": "table",
          "instant": true,
          "refId": "G"
