{
  "annotations": { "list": [] },
  "description": "Loki log aggregation health, ingestion, query performance, and resource usage",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "← Back to Cluster",
      "type": "link",
      "url": "/d/otel-kubernetes-cluster"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Namespace Detail →",
      "type": "link",
      "url": "/d/otel-kubernetes-namespace?var-namespace=loki"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Health Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Loki Up",
      "description": "Whether the Loki process is up and responding to scrapes. Green (1) = healthy, Red (0) = down.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "up{job=~\".*loki.*\"}", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Ingestion Rate",
      "description": "Rate of log lines being received by the distributor. A sudden drop may indicate upstream collection issues.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(loki_distributor_lines_received_total[5m]))", "legendFormat": "lines/s", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Push Errors/s",
      "description": "Rate of failed push requests (non-2xx responses). Any sustained errors indicate log loss.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(loki_request_duration_seconds_count{route=~\"otlp_v1_logs|loki_api_v1_push\",status_code!~\"2..|success\"}[5m])) or vector(0)", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Query Rate",
      "description": "Rate of query requests being processed by Loki.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(loki_request_duration_seconds_count{route=~\"loki_api_v1_query.*\"}[5m])) or vector(0)", "legendFormat": "queries/s", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Discarded Lines",
      "description": "Rate of log lines being discarded due to rate limits, label limits, or other validation errors. Any value above zero means log loss.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(loki_discarded_samples_total[5m])) or vector(0)", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "Ingestion",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Push Request Rate",
      "description": "Rate of push requests by HTTP status code. 2xx = success, 4xx = client errors (bad labels, rate limited), 5xx = server errors.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/2..|success/" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "/4../" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byRegexp", "options": "/5..|error/" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (status_code) (rate(loki_request_duration_seconds_count{route=~\"otlp_v1_logs|loki_api_v1_push\"}[$__rate_interval]))", "legendFormat": "{{`{{status_code}}`}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Bytes Received",
      "description": "Rate of bytes being received by the distributor from log producers.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(rate(loki_distributor_bytes_received_total[$__rate_interval]))", "legendFormat": "Received", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Lines Received by Tenant",
      "description": "Top 5 tenants by log line ingestion rate. In single-tenant mode, all lines appear under the 'fake' tenant.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "topk(5, sum by (tenant) (rate(loki_distributor_lines_received_total[$__rate_interval])))", "legendFormat": "{{`{{tenant}}`}}", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 300,
      "title": "Query Performance",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Query Latency (p50/p99)",
      "description": "Query request latency at p50 and p99 percentiles. High p99 with low p50 indicates occasional slow queries (likely large time ranges or unoptimized label matchers).",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum(rate(loki_request_duration_seconds_bucket{route=~\"loki_api_v1_query.*\"}[$__rate_interval])) by (le))", "legendFormat": "p99", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(loki_request_duration_seconds_bucket{route=~\"loki_api_v1_query.*\"}[$__rate_interval])) by (le))", "legendFormat": "p50", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "title": "Query Request Rate",
      "description": "Rate of query, label, and series API requests by route and status code.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10 }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (route, status_code) (rate(loki_request_duration_seconds_count{route=~\"loki_api_v1_query.*|loki_api_v1_label.*|loki_api_v1_series|loki_api_v1_index.*\"}[$__rate_interval]))", "legendFormat": "{{`{{route}}`}} {{`{{status_code}}`}}", "refId": "A" }
      ]
    },
    {
      "id": 11,
      "title": "Query Errors",
      "description": "Rate of 5xx errors on query-related routes. Shows 'No data' when there are no errors, which is the healthy state.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (route) (rate(loki_request_duration_seconds_count{route=~\"loki_api_v1_query.*\",status_code=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{`{{route}}`}}", "refId": "A" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 },
      "id": 400,
      "title": "Loki Resources",
      "type": "row"
    },
    {
      "id": 19,
      "title": "Loki",
      "description": "Availability of the Loki StatefulSet over the selected window. Ratio of ready to desired pods, averaged over time.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.995 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(({__name__=\"k8s.statefulset.ready_pods\",\"k8s.namespace.name\"=\"loki\",\"k8s.statefulset.name\"=\"loki\"} / {__name__=\"k8s.statefulset.desired_pods\",\"k8s.namespace.name\"=\"loki\",\"k8s.statefulset.name\"=\"loki\"})[${availability_window}:5m])", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 20,
      "title": "Gateway",
      "description": "Availability of the Loki Gateway Deployment over the selected window. Ratio of available to desired replicas, averaged over time.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.995 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(({__name__=\"k8s.deployment.available\",\"k8s.namespace.name\"=\"loki\",\"k8s.deployment.name\"=\"loki-gateway\"} / {__name__=\"k8s.deployment.desired\",\"k8s.namespace.name\"=\"loki\",\"k8s.deployment.name\"=\"loki-gateway\"})[${availability_window}:5m])", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 21,
      "title": "Chunks Cache",
      "description": "Availability of the Loki Chunks Cache StatefulSet over the selected window.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.995 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(({__name__=\"k8s.statefulset.ready_pods\",\"k8s.namespace.name\"=\"loki\",\"k8s.statefulset.name\"=\"loki-chunks-cache\"} / {__name__=\"k8s.statefulset.desired_pods\",\"k8s.namespace.name\"=\"loki\",\"k8s.statefulset.name\"=\"loki-chunks-cache\"})[${availability_window}:5m])", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 22,
      "title": "Results Cache",
      "description": "Availability of the Loki Results Cache StatefulSet over the selected window.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.995 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "avg_over_time(({__name__=\"k8s.statefulset.ready_pods\",\"k8s.namespace.name\"=\"loki\",\"k8s.statefulset.name\"=\"loki-results-cache\"} / {__name__=\"k8s.statefulset.desired_pods\",\"k8s.namespace.name\"=\"loki\",\"k8s.statefulset.name\"=\"loki-results-cache\"})[${availability_window}:5m])", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 23,
      "title": "CPU Waste",
      "description": "Percentage of requested CPU not being used. High waste means resources are over-provisioned — consider reducing CPU requests.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "orange", "value": 0.9 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "1 - (sum({__name__=\"k8s.pod.cpu.usage\",\"k8s.namespace.name\"=\"loki\"}) / sum({__name__=\"k8s.container.cpu_request\",\"k8s.namespace.name\"=\"loki\"}))", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 24,
      "title": "Memory Waste",
      "description": "Percentage of requested memory not being used. Some headroom is expected — investigate if consistently above 70%.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "orange", "value": 0.9 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "1 - (sum({__name__=\"k8s.pod.memory.working_set\",\"k8s.namespace.name\"=\"loki\"}) / sum({__name__=\"k8s.container.memory_request\",\"k8s.namespace.name\"=\"loki\"}))", "legendFormat": "", "refId": "A" }
      ]
    },
    {
      "id": 12,
      "title": "CPU: Usage vs Requests",
      "description": "Namespace-level aggregate CPU usage compared to sum of container CPU requests — shows if Loki is over/under-provisioned.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Requests" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max", "mean"], "displayMode": "table" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum({__name__=\"k8s.pod.cpu.usage\",\"k8s.namespace.name\"=\"loki\"})", "legendFormat": "Usage", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum({__name__=\"k8s.container.cpu_request\",\"k8s.namespace.name\"=\"loki\"})", "legendFormat": "Requests", "refId": "B" }
      ]
    },
    {
      "id": 13,
      "title": "Memory: Usage vs Requests vs Limits",
      "description": "Namespace-level aggregate memory working set compared to sum of container memory requests and limits — shows if Loki is over/under-provisioned.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Requests" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Limits" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull", "max", "mean"], "displayMode": "table" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum({__name__=\"k8s.pod.memory.working_set\",\"k8s.namespace.name\"=\"loki\"})", "legendFormat": "Usage", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum({__name__=\"k8s.container.memory_request\",\"k8s.namespace.name\"=\"loki\"})", "legendFormat": "Requests", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum({__name__=\"k8s.container.memory_limit\",\"k8s.namespace.name\"=\"loki\"})", "legendFormat": "Limits", "refId": "C" }
      ]
    },
    {
      "id": 14,
      "title": "Container Restarts",
      "description": "Total container restart count for Loki pods. Increasing restarts indicate OOMKills, crashes, or liveness probe failures.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 50 }
        }
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
