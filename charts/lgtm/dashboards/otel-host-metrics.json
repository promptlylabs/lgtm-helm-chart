{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "enable": true,
        "expr": "increase(argocd_app_sync_total{namespace=\"argocd\", phase=\"Succeeded\"}[$__rate_interval]) > 0",
        "hide": false,
        "iconColor": "green",
        "name": "ArgoCD Sync",
        "step": "60s",
        "tagKeys": "name",
        "textFormat": "",
        "titleFormat": "Sync: {{name}}",
        "type": "dashboard",
        "useValueForTime": false
      }
    ]
  },
  "description": "Host metrics from OTel hostmetricsreceiver (NoTranslation strategy)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "title": "← Back to Cluster",
      "tooltip": "Return to cluster-wide overview",
      "type": "link",
      "url": "/d/otel-kubernetes-cluster?var-node=$node"
    },
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Network →",
      "tooltip": "View network traffic across nodes and namespaces",
      "type": "link",
      "url": "/d/otel-network?var-node=$node"
    }
  ],
