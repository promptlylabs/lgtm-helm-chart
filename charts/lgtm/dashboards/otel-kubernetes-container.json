        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values({__name__=\"container.cpu.usage\", \"k8s.namespace.name\"=\"$namespace\", \"k8s.pod.name\"=~\"$pod\"}, \"k8s.container.name\")",
        "hide": 0,
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values({__name__=\"container.cpu.usage\", \"k8s.namespace.name\"=\"$namespace\", \"k8s.pod.name\"=~\"$pod\"}, \"k8s.container.name\")",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "utc",
  "title": "OTel Container Detail",
  "uid": "otel-kubernetes-container"
}
