      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=\"k8s.volume.capacity\", \"k8s.volume.type\"=\"persistentVolumeClaim\", \"k8s.namespace.name\"=~\"$namespace\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "{__name__=\"k8s.volume.available\", \"k8s.volume.type\"=\"persistentVolumeClaim\", \"k8s.namespace.name\"=~\"$namespace\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ],
      "title": "PVC Utilization",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "k8s.volume.name",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Used",
            "binary": {
              "left": "Value #A",
              "operator": "-",
              "right": "Value #B"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Usage %",
            "binary": {
              "left": "Used",
              "operator": "/",
              "right": "Value #A"
            },
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__type__": true,
              "__type__ 1": true,
              "__type__ 2": true,
              "__unit__": true,
              "__unit__ 1": true,
              "__unit__ 2": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "k8s.volume.type": true,
              "k8s.volume.type 1": true,
              "k8s.volume.type 2": true,
              "k8s.node.name": true,
              "k8s.node.name 1": true,
              "k8s.node.name 2": true,
              "k8s.namespace.name 1": true,
              "k8s.pod.name 1": true,
              "k8s.pod.uid": true,
              "k8s.pod.uid 1": true,
              "k8s.pod.uid 2": true,
              "k8s.volume.name 1": true,
              "cloud.availability_zone": true,
              "cloud.availability_zone 1": true,
              "cloud.availability_zone 2": true,
              "k8s.persistentvolumeclaim.name": true,
              "k8s.persistentvolumeclaim.name 1": true,
              "k8s.persistentvolumeclaim.name 2": true,
              "net.host.name": true,
              "net.host.name 1": true,
              "net.host.name 2": true,
              "net.host.port": true,
              "net.host.port 1": true,
              "net.host.port 2": true,
              "http.scheme": true,
              "http.scheme 1": true,
              "http.scheme 2": true,
              "service.name": true,
              "service.name 1": true,
              "service.name 2": true,
              "service.instance.id": true,
              "service.instance.id 1": true,
              "service.instance.id 2": true
            },
            "indexByName": {
              "k8s.namespace.name": 0,
              "k8s.volume.name": 1,
              "k8s.pod.name": 2,
              "Value #A": 3,
              "Used": 4,
              "Value #B": 5,
              "Usage %": 6
            },
            "renameByName": {
              "k8s.namespace.name": "Namespace",
              "k8s.volume.name": "PVC",
              "k8s.pod.name": "Pod",
              "Value #A": "Capacity",
              "Used": "Used",
              "Value #B": "Available",
              "Usage %": "Usage %"
            }
          }
        }
      ],
      "type": "table"
    },
