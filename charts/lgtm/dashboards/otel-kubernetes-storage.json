                "id": "max",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "k8s.namespace.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Namespace"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "k8s.pod.name"
