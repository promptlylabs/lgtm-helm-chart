          "legendFormat": "p99",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(grafana_http_request_duration_seconds_bucket{handler!~\"/api/health|/metrics|/api/live/.*\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(grafana_http_request_duration_seconds_sum{handler!~\"/api/health|/metrics|/api/live/.*\"}[$__rate_interval])) / sum(rate(grafana_http_request_duration_seconds_count{handler!~\"/api/health|/metrics|/api/live/.*\"}[$__rate_interval]))",
          "legendFormat": "avg",
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ]
