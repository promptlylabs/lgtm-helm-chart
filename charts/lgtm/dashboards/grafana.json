          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status_code) (rate(grafana_http_request_duration_seconds_count{handler!~\"/api/health|/metrics|/api/live/.*\"}[$__rate_interval]))",
